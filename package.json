{
  "name": "appii",
  "version": "0.1.0",
  "description": "Turn any website into your own API: inspect cookies, capture endpoint traffic, validate and submit forms like a browser, infer OpenAPI specs, and serve custom API routes.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "appii": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "playwright": "1.56.1",
    "tough-cookie": "^6.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
