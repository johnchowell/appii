{
  "name": "appii",
  "version": "0.1.0",
  "description": "Turn any website into a usable API description: record traffic in Chromium, infer endpoints, schemas, cookies, CSRF tokens and form rules, and export OpenAPI, Postman, curl, a TypeScript client and more.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "appii": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "playwright": "1.56.1",
    "tldts": "^7.4.16",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
